cat << 'EOF' > .gitignore
# Entornos virtuales de Python
venv/
.venv/
env/
ENV/

# Archivos de entorno y credenciales sensibles
.env

# Archivos compilados y caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Archivos de configuración de IDEs (VS Code)
.vscode/
.idea/

# Base de datos local o volcados temporales
*.sqlite3
*.log
EOF