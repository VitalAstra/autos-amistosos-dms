/* Paleta base: blanco, gris claro y tonos slate discretos. */
QMainWindow,
QWidget {
    color: #212529;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

QMainWindow,
QWidget#centralWidget {
    background-color: #F8F9FA;
}

/* Tarjetas y superficies. */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;
}

QLabel#viewTitle,
QLabel#sidebarTitle {
    background: transparent;
    color: #212529;
    font-size: 14pt;
    font-weight: 600;
}

QLabel#sidebarTitle {
    color: #495057;
    font-size: 11pt;
}

QLabel#metricTitle {
    background: transparent;
    color: #6C757D;
    font-size: 10pt;
}

QLabel#metricValue {
    background: transparent;
    color: #212529;
    font-size: 20pt;
    font-weight: 600;
}

QLabel#totalValue {
    background: transparent;
    color: #212529;
    font-size: 12pt;
    font-weight: 700;
}

QPushButton#primaryButton {
    background-color: #6C757D;
    border-color: #6C757D;
    color: #FFFFFF;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#primaryButton:hover {
    background-color: #5A6268;
    border-color: #5A6268;
}

QPushButton#primaryButton:pressed {
    background-color: #495057;
    border-color: #495057;
}

QListWidget {
    background-color: #FFFFFF;
    border: 0;
    outline: 0;
}

QListWidget::item {
    background-color: #F8F9FA;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    margin: 4px 0;
    padding: 12px;
}

QListWidget::item:hover {
    background-color: #E9ECEF;
}

QListWidget::item:selected {
    background-color: #DEE2E6;
    color: #212529;
}

/* Botones y navegación lateral. */
QPushButton {
    background-color: #E9ECEF;
    color: #212529;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #DEE2E6;
    border-color: #DEE2E6;
}

QPushButton:pressed {
    background-color: #CED4DA;
}

QPushButton:disabled {
    background-color: #F1F3F5;
    color: #ADB5BD;
}

QFrame#sidebar {
    background-color: #FFFFFF;
    border: 0;
    border-right: 1px solid #DEE2E6;
}

QPushButton#navButton {
    background-color: transparent;
    border: 0;
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
}

QPushButton#navButton:hover {
    background-color: #F1F3F5;
}

QPushButton#navButton[active="true"] {
    background-color: #E9ECEF;
    color: #212529;
    font-weight: 600;
}

/* Campos editables y selectores. */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #DEE2E6;
    selection-color: #212529;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #495057;
}

QComboBox::drop-down {
    border: 0;
    width: 24px;
}

/* Tablas: encabezados sobrios y filas alternadas. */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    gridline-color: #E9ECEF;
    selection-background-color: #DEE2E6;
    selection-color: #212529;
}

QHeaderView::section {
    background-color: #E9ECEF;
    color: #495057;
    border: 0;
    border-bottom: 1px solid #DEE2E6;
    padding: 9px 8px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #E9ECEF;
    border: 0;
    border-bottom: 1px solid #DEE2E6;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #DEE2E6;
    color: #212529;
}

QScrollBar:vertical {
    background-color: #F8F9FA;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #CED4DA;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: 0;
}
