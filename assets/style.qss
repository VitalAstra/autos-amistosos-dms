QMainWindow,
QWidget {
    color: #1F2937;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #F8F9FA;
    color: #212529;
}

QWidget#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F3F7F9, stop:1 #EEF3F1);
    color: #212529;
}

QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QFrame#subCard {
    background-color: #F8F9FA;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
}

QLabel#viewTitle,
QLabel#sidebarTitle,
QLabel#brandTitle {
    background: transparent;
    color: #111827;
    font-size: 15pt;
    font-weight: 700;
}

QLabel#sidebarTitle,
QLabel#brandTitle {
    color: #0F172A;
    letter-spacing: 0.5px;
}

QLabel#sectionTitle {
    background: transparent;
    color: #343A40;
    font-weight: 600;
}

QLabel#sidebarTitle {
    font-size: 12pt;
    padding-bottom: 8px;
}

QLabel#metricTitle {
    color: #6B7280;
    font-size: 10pt;
    font-weight: 600;
}

QLabel#metricValue {
    color: #0F172A;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#totalValue {
    color: #0F172A;
    font-size: 12pt;
    font-weight: 700;
}

QPushButton#primaryButton {
    background-color: #1D4ED8;
    border: 1px solid #1D4ED8;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#primaryButton:hover {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

QPushButton#primaryButton:pressed {
    background-color: #1E3A8A;
}

QListWidget {
    background-color: #FFFFFF;
    border: 0;
    outline: 0;
}

QListWidget::item {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin: 4px 0;
    padding: 12px;
}

QListWidget::item:hover {
    background-color: #EEF2FF;
}

QListWidget::item:selected {
    background-color: #DBEAFE;
    color: #0F172A;
}

QPushButton {
    background-color: #F3F4F6;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #E5E7EB;
}

QPushButton:pressed {
    background-color: #D1D5DB;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:1 #F8FAFC);
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QPushButton#navButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 600;
}

QPushButton#navButton:hover {
    background-color: #F1F5F9;
}

QPushButton#navButton[active="true"] {
    background-color: #DBEAFE;
    color: #1E3A8A;
    border-color: #BFDBFE;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #BFDBFE;
    selection-color: #0F172A;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #3B82F6;
}

QComboBox::drop-down {
    border: 0;
    width: 24px;
}

/* Asegurar que el popup de los ComboBox, QCompleter y las vistas listadas usen el tema claro */
QAbstractItemView,
QListView,
QMenu {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #E9ECEF;
}

QAbstractItemView::item,
QListView::item,
QMenu::item {
    padding: 6px 10px;
}

QAbstractItemView::item:selected,
QListView::item:selected,
QMenu::item:selected {
    background-color: #DEE2E6;
    color: #212529;
}

/* Dialogs y MessageBoxes */
QDialog,
QMessageBox {
    background-color: #FFFFFF;
    color: #212529;
}

QDialog QWidget,
QMessageBox QWidget {
    color: #212529;
}

QMessageBox QLabel {
    background: transparent;
    color: #212529;
}

QMessageBox QPushButton {
    background-color: #E9ECEF;
    color: #212529;
    border-radius: 6px;
    padding: 6px 12px;
}

QMessageBox QPushButton:hover {
    background-color: #DEE2E6;
}

QToolTip {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    padding: 4px;
}

QCalendarWidget,
QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #212529;
}

QCalendarWidget QToolButton {
    background-color: #E9ECEF;
    color: #212529;
    border: 0;
    border-radius: 4px;
    padding: 5px;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #212529;
    selection-background-color: #DEE2E6;
    selection-color: #212529;
}

/* Tablas: encabezados sobrios y filas alternadas. */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    border: 0;
    border-bottom: 1px solid #E2E8F0;
    padding: 9px 8px;
    font-weight: 700;
}

QTableCornerButton::section {
    background-color: #F1F5F9;
    border: 0;
    border-bottom: 1px solid #E2E8F0;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #DBEAFE;
    color: #0F172A;
}

QScrollBar:vertical {
    background-color: #F8FAFC;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: 0;
}
